<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#0A0A1A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FORZAWHEEL"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#5599FF"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/btn_start_wheel"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="START WHEEL"
        android:backgroundTint="#2255CC"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_settings"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="SETTINGS"
        android:backgroundTint="#333344"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_diagnostics"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="SENSOR DIAGNOSTICS"
        android:backgroundTint="#333344" />

</LinearLayout>
